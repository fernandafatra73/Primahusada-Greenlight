# Local SQLite file (relative to apps/api). No server/password needed.
DATABASE_URL="file:./dev.db"
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:1973"

# Google Gemini API key, dipakai fitur analisa foto AI (Anatomi > AI Foto).
# Dapatkan di https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Opsional: kunci rahasia untuk menghitung kode aktivasi lisensi (lihat
# src/lib/activation.ts). Sudah ada nilai default bawaan jika dikosongkan,
# tapi harus SAMA antara server ini dan yang dipakai npm run activation:code.
ACTIVATION_SECRET=""
